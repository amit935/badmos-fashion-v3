{
  "collectionName": "components_navigation_nav_tabs",
  "info": {
    "displayName": "Nav Tab / Header Dropdown",
    "icon": "bulletList",
    "description": "Navigation tab in header bar, can be dropdown or direct link"
  },
  "options": {},
  "attributes": {
    "tabName": {
      "type": "string",
      "required": true
    },
    "type": {
      "type": "enumeration",
      "default": "dropdown",
      "enum": [
        "dropdown",
        "direct_link"
      ]
    },
    "url": {
      "type": "string"
    },
    "onlyFetchFromVendure": {
      "type": "boolean"
    },
    "showManualListFirst": {
      "type": "boolean",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "onlyFetchFromVendure"
            },
            false
          ]
        }
      }
    },
    "isExternal": {
      "type": "boolean",
      "default": false
    },
    "categories": {
      "type": "component",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "onlyFetchFromVendure"
            },
            false
          ]
        }
      },
      "component": "navigation.nav-category",
      "repeatable": true
    },
    "vendureCollections": {
      "type": "component",
      "repeatable": true,
      "component": "navigation.vendure-collection"
    }
  }
}
