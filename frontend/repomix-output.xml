<file path="app/components/header/desktop/right-navigation-bar.vue">
<script setup>
import { ref, computed } from 'vue'
import { useRouter } from 'vue-router'
import { storeToRefs } from 'pinia'
import { useAuthStore } from '~/store/auth'
import { useSignout } from '~/composables/useSignout.js'
import { useCartStore } from '~/store/cart'

const cart = useCartStore()
const { isPanelOpen } = storeToRefs(cart)

const toggleCartPanel = () => {
  isPanelOpen.value = !isPanelOpen.value
}

const props = defineProps({
  headerData: { type: Object, default: null }
})

const authStore = useAuthStore()
const { isAuthenticated } = storeToRefs(authStore)
const { signOut } = useSignout()
const router = useRouter()

const activeHeaderData = computed(() => props.headerData)

const userMenuItems = computed(() => {
  const strapiLinks = activeHeaderData.value?.userMenu?.userLinks
  if (strapiLinks && strapiLinks.length > 0) {
    return strapiLinks.map(l => ({ name: l.title, url: l.url }))
  }
  return []
})

const route = useRoute()
const isCheckoutPage = computed(() => route.path.startsWith('/checkout'))

const showCartButton = computed(
  () => activeHeaderData.value?.showCartButton !== false && !isCheckoutPage.value
)
const guestTitle = computed(() => activeHeaderData.value?.userMenu?.guestTitle || 'Welcome to Badmos Fashion')
const joinClanLabel = computed(() => activeHeaderData.value?.userMenu?.joinClanButtonLabel || 'Join The Clan')
const joinClanUrl = computed(() => activeHeaderData.value?.userMenu?.joinClanButtonUrl || '/login')
const signOutLabel = computed(() => activeHeaderData.value?.userMenu?.signOutLabel || 'Sign Out')

const goToJoinClan = () => {
  if (joinClanUrl.value.startsWith('http')) {
    window.location.href = joinClanUrl.value
  } else {
    router.push(joinClanUrl.value)
  }
}

const signOutAndRedirect = async () => {
  try {
    await signOut()
    window.location.href = '/'
  } catch (error) {
    console.error('Error during sign out:', error)
  }
}

const menuOpen = ref(false)
const toggleMenu = () => { menuOpen.value = !menuOpen.value }
</script>

<template>
    <nav>
        <ul class="flex gap-6">
           <li v-if="showCartButton">
              <button
                @click="toggleCartPanel"
                class="relative h-full px-2 py-1 flex items-center border-b-3 border-transparent cursor-pointer"
                aria-label="Open cart"
              >
                <Icon name="material-symbols:shopping-bag" size="24" />
                <span
                  v-if="cart.itemCount > 0"
                  class="absolute -top-1 -right-1 bg-black text-white text-xs rounded-full min-w-5 h-5 px-1 flex items-center justify-center"
                >
                  {{ cart.itemCount }}
                </span>
              </button>

              <div
                v-if="isPanelOpen"
                class="fixed h-[100vh] w-[100%] md:w-[35%] top-0 right-0 bg-white z-20 pt-10 px-8 border-l-2 border-black"
              >
                <CartPanel @toggleMenu="toggleCartPanel" />
              </div>
            </li>
            <li>
                <UiDropdown panelDir="right">
                    <template #header>
                        <Icon name="material-symbols:person" size="24" />
                    </template>
                    <template #panel>
                        <div v-if="isAuthenticated" class="p-4 flex flex-col gap-1">
                            <div v-for="userLink in userMenuItems" :key="userLink.name + userLink.url">
                                <NuxtLink
                                    v-if="!userLink.url.startsWith('http')"
                                    :to="userLink.url"
                                    class="block text-base font-semibold text-center py-1 hover:text-gray-600 border-b border-gray-100"
                                >
                                    {{ userLink.name }}
                                </NuxtLink>
                                <a
                                    v-else
                                    :href="userLink.url"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="block text-base font-semibold text-center py-1 hover:text-gray-600 border-b border-gray-100"
                                >
                                    {{ userLink.name }}
                                </a>
                            </div>
                            <button
                                @click="signOutAndRedirect()"
                                class="w-full text-center text-base font-semibold text-red-600 hover:text-red-800 transition-colors cursor-pointer"
                            >
                                {{ signOutLabel }}
                            </button>
                        </div>
                        <div v-else class="flex flex-col gap-4 p-6 items-center min-w-[220px]">
                            <h1 class="text-2xl text-center font-bold secondary-font">{{ guestTitle }}</h1>
                            <UiButton @click="goToJoinClan" :text="joinClanLabel" class="w-full text-center"/>
                        </div>
                    </template>
                </UiDropdown>
            </li>

        </ul>
    </nav>
</template>
</file>

<file path="app/components/header/mobile/left-navigation-panel.vue">
<script setup>
import { ref, computed } from 'vue';
import { useNavTabs } from '~/composables/useNavTabs.js';

const props = defineProps({
  headerData: { type: Object, default: null },
  toggleMenu: { type: Function, default: null },
});
const emit = defineEmits(['toggleMenu']);

const headerRef = computed(() => props.headerData);
const { navTabs } = await useNavTabs(headerRef);

const openTabs = ref(new Set());
const expandedItems = ref(new Set());

const toggleTab = (tabKey) => {
  if (openTabs.value.has(tabKey)) openTabs.value.delete(tabKey);
  else openTabs.value.add(tabKey);
};

const toggleItem = (itemKey) => {
  if (expandedItems.value.has(itemKey)) expandedItems.value.delete(itemKey);
  else expandedItems.value.add(itemKey);
};
</script>

<template>
  <button 
    @click="emit('toggleMenu')" 
    class="p-1 absolute top-0 left-0 m-10 text-gray-400 hover:text-red-600 transition-colors"
    aria-label="Close menu"
  >
    <Icon name="material-symbols:close" size="24" />
  </button>
  <nav class="mt-12">
    <ul class="flex flex-col gap-4 p-4">
      <li v-for="tab in navTabs" :key="tab.tabName + (tab.url || '')">
        <a 
          v-if="tab.type === 'direct_link'"
          :href="tab.url || '#'"
          class="font-bold uppercase block py-2 text-lg hover:text-gray-600"
        >
          {{ tab.tabName }}
        </a>

        <div v-else>
          <button 
            @click="toggleTab(tab.tabName)" 
            class="font-bold uppercase flex items-center justify-between w-full py-2"
          >
            <span>{{ tab.tabName }}</span>
            <svg 
              xmlns="http://www.w3.org/2000/svg" 
              class="h-5 w-5 transition-transform"
              :class="{ 'rotate-180': openTabs.has(tab.tabName) }"
              fill="none" 
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          
          <div v-show="openTabs.has(tab.tabName)" class="mt-2 ml-4">
            <div
              v-for="category in tab.categories"
              :key="category.title + (category.url || '')"
              class="flex flex-col mb-3"
            >
              <a
                :href="category.url || '#'"
                class="text-lg font-semibold py-2 hover:text-gray-600"
              >
                {{ category.title }}
              </a>

              <div v-if="category.sections && category.sections.length > 0">
                <div
                  v-for="section in category.sections"
                  :key="section.title + (section.url || '')"
                  class="ml-4"
                >
                  <button
                    v-if="section.items && section.items.length > 0"
                    @click="toggleItem(section.title)"
                    class="flex items-center justify-between w-full text-gray-800 text-lg font-medium py-1 hover:text-gray-600"
                  >
                    <span>{{ section.title }}</span>
                    <svg 
                      xmlns="http://www.w3.org/2000/svg" 
                      class="h-4 w-4 transition-transform"
                      :class="{ 'rotate-180': expandedItems.has(section.title) }"
                      fill="none" 
                      viewBox="0 0 24 24" 
                      stroke="currentColor"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                    </svg>
                  </button>
                  <a
                    v-else
                    :href="section.url || '#'"
                    class="block text-gray-800 text-lg font-medium py-1 hover:text-gray-600"
                  >
                    {{ section.title }}
                  </a>

                  <div 
                    v-if="section.items && expandedItems.has(section.title)"
                    class="ml-4"
                  >
                    <a
                      v-for="item in section.items"
