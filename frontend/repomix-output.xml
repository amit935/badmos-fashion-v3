<file path="app/composables/useNavTabs.js">
import { gql } from 'graphql-request';
import { getClient } from '~/api/client';

const GET_COLLECTION_TREE = gql`
  query GetCollectionTree($slug: String!) {
    collection(slug: $slug) {
      name
      slug
      children {
        name
        slug
        children { name slug }
      }
    }
  }
`;

const TTL_MS = 60 * 1000;
const cache = new Map(); // slug -> { at, tree }

const normalizeSlug = (s) =>
  String(s || '').trim().toLowerCase().replace(/\s+/g, '-');

async function fetchTree(slug) {
  const hit = cache.get(slug);
  if (hit && Date.now() - hit.at < TTL_MS) return hit.tree;
  try {
    const data = await getClient().request(GET_COLLECTION_TREE, { slug });
    cache.set(slug, { at: Date.now(), tree: data.collection });
    return data.collection;
  } catch (err) {
    console.warn(`Vendure collection "${slug}" could not be loaded`, err?.message);
    return null;
  }
}

// The slug is a container: its children become the dropdown columns
function toCategories(col) {
  return (col.children || []).map((child) => ({
    title: child.name,
    url: `/${child.slug}`,
    sections: (child.children || []).map((g) => ({
      title: g.name,
      url: `/${child.slug}/${g.slug}`,
      items: [],
    })),
  }));
}

async function resolveTab(tab) {
  const slugs = (tab.vendureCollections || [])
    .map((c) => normalizeSlug(c.slug))
    .filter(Boolean);

  if (tab.type !== 'dropdown' || slugs.length === 0) return tab;

  const trees = await Promise.all(slugs.map(fetchTree));
  const fromVendure = trees.filter(Boolean).flatMap(toCategories);

  if (tab.onlyFetchFromVendure) return { ...tab, categories: fromVendure };

  const manual = tab.categories || [];
  const manualFirst = tab.showManualListFirst !== false;
  return {
    ...tab,
    categories: manualFirst ? [...manual, ...fromVendure] : [...fromVendure, ...manual],
  };
}

// Call as: const { navTabs } = await useNavTabs(headerRef)
export async function useNavTabs(headerDataRef) {
  const { data } = await useAsyncData(
    'nav-tabs',
    async () => {
      const tabs = headerDataRef.value?.leftNavTabs;
      return tabs?.length ? await Promise.all(tabs.map(resolveTab)) : [];
    },
    { watch: [headerDataRef] }
  );
  return { navTabs: computed(() => data.value || []) };
}
</file>

<file path="app/composables/usePriceFormatter.js">
import { useI18n } from 'vue-i18n';

export function usePriceFormatter() {
  const { t } = useI18n();

  // amount: Vendure minor units (4999 = 49.99). currencyCode: ISO code from Vendure.
  const formatPrice = (amount, currencyCode) => {
    if (amount === undefined || amount === null || amount === '') return '';
    const minor = Number(amount);
    if (Number.isNaN(minor)) return String(amount);

    try {
      return new Intl.NumberFormat(t('locale.currency'), {
        style: 'currency',
        currency: currencyCode || 'INR',
      }).format(minor / 100);
    } catch {
      return `${currencyCode || ''} ${(minor / 100).toFixed(2)}`.trim();
    }
  };

  return { formatPrice };
}
</file>

<file path="app/composables/useProducts.js">
import { ref } from 'vue';
import { useRuntimeConfig } from '#imports';

/**
 * Composable for loading and managing product lists.
 * Supports direct product arrays, category collection slugs, or product ID queries.
 */
export function useProducts(initialProducts = []) {
  const products = ref(initialProducts || []);
  const isLoading = ref(false);
  const error = ref(null);
  const runtimeConfig = useRuntimeConfig();

  /**
   * Fetch products by category / collection slugs
   */
  const loadProductsByCollections = async (categorySlugs) => {
    if (!categorySlugs || categorySlugs.length === 0) return;
    isLoading.value = true;
    error.value = null;

    try {
      const response = await $fetch('/api/shop/products', {
        query: { collections: categorySlugs.join(',') }
      }).catch(() => null);

      if (response && Array.isArray(response.products)) {
        products.value = response.products;
      } else if (Array.isArray(response)) {
        products.value = response;
      } else {
        products.value = [];
      }
    } catch (err) {
      console.warn('Unable to fetch products by collections:', err);
      error.value = err.message || 'Failed to load products';
      products.value = [];
    } finally {
      isLoading.value = false;
    }
  };

  /**
   * Fetch products by product IDs
   */
  const loadProductsByIds = async (productIds) => {
    if (!productIds || productIds.length === 0) return;
    isLoading.value = true;
    error.value = null;

    try {
      const response = await $fetch('/api/shop/products', {
        query: { ids: productIds.join(',') }
      }).catch(() => null);

      if (response && Array.isArray(response.products)) {
        products.value = response.products;
      } else if (Array.isArray(response)) {
        products.value = response;
      } else {
        products.value = [];
      }
    } catch (err) {
      console.warn('Unable to fetch products by IDs:', err);
      error.value = err.message || 'Failed to load products';
      products.value = [];
    } finally {
      isLoading.value = false;
    }
  };

  /**
   * Fetch products by slug pointers (stored in Strapi)
   */
  const loadProductsBySlugs = async (productSlugs) => {
    if (!productSlugs || productSlugs.length === 0) return;
    isLoading.value = true;
    error.value = null;

    try {
      const response = await $fetch('/api/shop/products', {
        query: { slugs: productSlugs.join(',') }
      }).catch(() => null);

      if (response && Array.isArray(response.products)) {
        products.value = response.products;
      } else if (Array.isArray(response)) {
        products.value = response;
      } else {
        products.value = [];
      }
    } catch (err) {
      console.warn('Unable to fetch products by slug pointers:', err);
      error.value = err.message || 'Failed to load products';
      products.value = [];
    } finally {
      isLoading.value = false;
    }
  };

  return {
    products,
    isLoading,
    error,
    loadProductsByCollections,
    loadProductsByIds,
    loadProductsBySlugs
  };
}
</file>

