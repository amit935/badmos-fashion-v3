import { defineStore } from 'pinia';
import { ref, computed, watch } from 'vue';
import { getClient } from '~/api/client';
import { ADD_ITEM_TO_ORDER, ADJUST_ORDER_LINE, REMOVE_ORDER_LINE } from '~/api/mutations';
import { GET_ACTIVE_ORDER } from '~/api/queries';
import { useAuthStore } from '~/store/auth';

const STORAGE_KEY = 'badmos-guest-cart';
const DEBOUNCE_MS = 600;

export const useCartStore = defineStore('cart', () => {
  // ── State ──
  const guestItems = ref([]);   // [{ variantId, quantity, name, image, options, path, unitPrice, currencyCode }]
  const order = ref(null);      // Vendure active order (logged-in users)
  const pending = ref({});      // variantId -> { quantity, snapshot } (local edits not yet confirmed)
  const error = ref(null);
  const mergeIssues = ref([]);  // guest lines Vendure could not add on login
  const isPanelOpen = ref(false);

  const timers = new Map();     // variantId -> debounce timer
  let queue = Promise.resolve(); // serial queue: server calls never overlap

  const isAuthed = () => useAuthStore().isAuthenticated;

  // ── Unified read model ──
  const serverItems = computed(() =>
    (order.value?.lines || []).map((l) => ({
      variantId: l.productVariant.id,
      lineId: l.id,
      quantity: l.quantity,
      name: l.productVariant.product.name,
      variantName: l.productVariant.name,
      image: l.featuredAsset?.preview || '',
      options: (l.productVariant.options || []).map((o) => o.name),
      path: `/${l.productVariant.product.slug}`, // resolve route redirects to the canonical path
      unitPrice: l.unitPriceWithTax,
      currencyCode: order.value.currencyCode,
    }))
  );

  // Server lines overlaid with pending local quantities, plus pending brand-new lines
  const authedItems = computed(() => {
    const out = serverItems.value
      .map((i) => ({ ...i, quantity: pending.value[i.variantId]?.quantity ?? i.quantity }))
      .filter((i) => i.quantity > 0);
    const known = new Set(serverItems.value.map((i) => i.variantId));
    for (const [variantId, p] of Object.entries(pending.value)) {
      if (!known.has(variantId) && p.quantity > 0 && p.snapshot) {
        out.push({ ...p.snapshot, variantId, quantity: p.quantity });
      }
    }
    return out;
  });

  const items = computed(() => (isAuthed() ? authedItems.value : guestItems.value));
  const itemCount = computed(() => items.value.reduce((n, i) => n + i.quantity, 0));
  const subtotal = computed(() => items.value.reduce((n, i) => n + i.unitPrice * i.quantity, 0));
  const currencyCode = computed(() => items.value[0]?.currencyCode || order.value?.currencyCode || 'INR');

  // ── Guest persistence (client only) ──
  function loadGuest() {
    try {
      guestItems.value = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
    } catch {
      guestItems.value = [];
    }
  }
  if (import.meta.client) {
    watch(guestItems, (v) => {
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(v)); } catch { /* storage blocked */ }
    }, { deep: true });
  }

  // ── Public actions ──
  // snapshot: { variantId, name, image, options, path, unitPrice, currencyCode }
  function add(snapshot, qty = 1) {
    const current = items.value.find((i) => i.variantId === snapshot.variantId)?.quantity || 0;
    setQuantity(snapshot.variantId, current + qty, snapshot);
  }

  function remove(variantId) {
    setQuantity(variantId, 0);
  }

  function setQuantity(variantId, quantity, snapshot) {
    const qty = Math.max(0, Math.floor(quantity));

    if (!isAuthed()) {
      const idx = guestItems.value.findIndex((i) => i.variantId === variantId);
      if (qty === 0) {
        if (idx >= 0) guestItems.value.splice(idx, 1);
      } else if (idx >= 0) {
        guestItems.value[idx].quantity = qty;
      } else if (snapshot) {
        guestItems.value.push({ ...snapshot, quantity: qty });
      }
      return;
    }

    // Logged in: optimistic local update, then sync
    const existing = pending.value[variantId]?.snapshot
      || items.value.find((i) => i.variantId === variantId);
    pending.value = { ...pending.value, [variantId]: { quantity: qty, snapshot: snapshot || existing } };

    clearTimeout(timers.get(variantId));
    const onServer = serverItems.value.some((i) => i.variantId === variantId);
    if (!onServer) {
      flushLine(variantId); // first add goes out immediately
    } else {
      timers.set(variantId, setTimeout(() => flushLine(variantId), DEBOUNCE_MS));
    }
  }

  // ── Server sync (logged-in) ──
  const enqueue = (fn) => {
    queue = queue.then(fn).catch(() => {});
    return queue;
  };

  function applyResult(res) {
    const next = res?.lines ? res : res?.order; // plain Order, or InsufficientStockError.order
    if (next?.lines) order.value = next;
    if (res?.errorCode) error.value = res.message || res.errorCode;
  }

  function flushLine(variantId) {
    clearTimeout(timers.get(variantId));
    timers.delete(variantId);

    return enqueue(async () => {
      const p = pending.value[variantId];
      if (!p) return;
      const sent = p.quantity;
      const line = order.value?.lines?.find((l) => l.productVariant.id === variantId);

      try {
        let res = null;
        if (!line) {
          if (sent > 0) res = (await getClient().request(ADD_ITEM_TO_ORDER, { variantId, quantity: sent })).addItemToOrder;
        } else if (sent <= 0) {
          res = (await getClient().request(REMOVE_ORDER_LINE, { lineId: line.id })).removeOrderLine;
        } else if (sent !== line.quantity) {
          res = (await getClient().request(ADJUST_ORDER_LINE, { lineId: line.id, quantity: sent })).adjustOrderLine;
        }
        if (res) applyResult(res);
      } catch (e) {
        error.value = e?.response?.errors?.[0]?.message || e.message || 'Could not update cart';
        await fetchActiveOrder();
      }

      // Clear pending only if the user hasn't edited again while the request was in flight
      if (pending.value[variantId]?.quantity === sent) {
        const { [variantId]: _drop, ...rest } = pending.value;
        pending.value = rest;
      }
    });
  }

  // Send everything now (before checkout, logout, or leaving the page)
  async function flushAll() {
    await Promise.all(Object.keys(pending.value).map(flushLine));
    await queue;
  }

  async function fetchActiveOrder() {
    try {
      const data = await getClient().request(GET_ACTIVE_ORDER);
      order.value = data.activeOrder || null;
    } catch {
      'fetchActiveOrder failed:', err?.response?.errors || err
    }
  }

  // ── Guest -> Vendure merge (call right after login succeeds) ──
  async function mergeGuestCart() {
    loadGuest();
    await fetchActiveOrder(); // reuse the existing active order if there is one
    mergeIssues.value = [];

    // Sequential on purpose: concurrent mutations on one order can race
    for (const item of [...guestItems.value]) {
      try {
        const res = (await getClient().request(ADD_ITEM_TO_ORDER, {
          variantId: item.variantId,
          quantity: item.quantity, // addItemToOrder accumulates onto an existing line
        })).addItemToOrder;
        applyResult(res);
        if (res?.errorCode) mergeIssues.value.push({ name: item.name, reason: res.message || res.errorCode });
        error.value = null;
        // Success or a definitive rejection: either way, don't retry this line
        guestItems.value = guestItems.value.filter((i) => i.variantId !== item.variantId);
      } catch {
        break; // network failure: keep the remaining guest lines for the next attempt
      }
    }
  }

  async function reset() {
    await flushAll();
    timers.forEach(clearTimeout);
    timers.clear();
    order.value = null;
    pending.value = {};
    error.value = null;
  }

  async function init() {
    loadGuest();
    if (isAuthed()) await fetchActiveOrder();
  }

  return {
    guestItems, order, pending, error, mergeIssues, isPanelOpen,
    items, itemCount, subtotal, currencyCode,
    add, remove, setQuantity, flushAll, fetchActiveOrder, mergeGuestCart, reset, init,
  };
});
</file>

<file path="app/store/checkout.js">
import { defineStore } from 'pinia';
import { ref } from 'vue';
import { getClient } from '~/api/client';
import {
  SET_ORDER_SHIPPING_ADDRESS,
  SET_ORDER_BILLING_ADDRESS,
  SET_ORDER_SHIPPING_METHOD,
  APPLY_COUPON_CODE,
  REMOVE_COUPON_CODE,
  TRANSITION_ORDER_TO_STATE,
  CREATE_CUSTOMER_ADDRESS,
} from '~/api/mutations';
import { GET_CHECKOUT_CUSTOMER, GET_ELIGIBLE_SHIPPING_METHODS } from '~/api/queries';
import { useCartStore } from '~/store/cart';

function createEmptyAddress() {
  return {
    fullName: '',
    phoneNumber: '',
    streetLine1: '',
    streetLine2: '',
    city: '',
    province: '',
    postalCode: '',
    countryCode: 'IN',
  };
}

// Turns a saved Vendure address into the shape the form uses
function addressFromSaved(saved) {
  return {
    fullName: saved.fullName || '',
    phoneNumber: saved.phoneNumber || '',
    streetLine1: saved.streetLine1 || '',
    streetLine2: saved.streetLine2 || '',
    city: saved.city || '',
    province: saved.province || '',
    postalCode: saved.postalCode || '',
    countryCode: saved.country?.code || 'IN',
  };
}

// Turns an address stored on the order into the shape the form uses
function addressFromOrder(orderAddress) {
  return {
    fullName: orderAddress.fullName || '',
    phoneNumber: orderAddress.phoneNumber || '',
    streetLine1: orderAddress.streetLine1 || '',
    streetLine2: orderAddress.streetLine2 || '',
    city: orderAddress.city || '',
    province: orderAddress.province || '',
    postalCode: orderAddress.postalCode || '',
    countryCode: orderAddress.countryCode || 'IN',
  };
}

// Only the fields Vendure accepts, with whitespace trimmed
function toAddressInput(address) {
  return {
    fullName: address.fullName.trim(),
    phoneNumber: address.phoneNumber.trim(),
    streetLine1: address.streetLine1.trim(),
    streetLine2: address.streetLine2.trim(),
    city: address.city.trim(),
    province: address.province.trim(),
    postalCode: address.postalCode.trim(),
    countryCode: address.countryCode,
  };
}

// A comparable string, so two addresses with the same content match
function addressKey(address) {
  return [
    address.fullName,
    address.phoneNumber,
    address.streetLine1,
    address.streetLine2,
    address.city,
    address.province,
    address.postalCode,
    address.countryCode,
  ]
    .map((value) => String(value || '').trim().toLowerCase())
    .join('|');
}

// Returns an error message, or an empty string when the address is fine
function validateAddress(address) {
  if (!address.fullName.trim()) return 'Please enter the full name.';
  if (!/^\d{10}$/.test(address.phoneNumber.trim())) return 'Phone number must be 10 digits.';
  if (!address.streetLine1.trim()) return 'Please enter the street address.';
  if (!address.city.trim()) return 'Please enter the city.';
  if (!address.province.trim()) return 'Please enter the state.';
  if (!/^\d{6}$/.test(address.postalCode.trim())) return 'Pincode must be 6 digits.';
  return '';
}

function readError(err) {
  return err?.response?.errors?.[0]?.message || err.message || 'Something went wrong';
}

export const useCheckoutStore = defineStore('checkout', () => {
  const cart = useCartStore();

  // ── State ──
  const shippingAddress = ref(createEmptyAddress());
  const billingAddress = ref(createEmptyAddress());
  const billingSameAsShipping = ref(true);

  // Addresses saved on the customer account: [{ id, ...address fields }]
  const savedAddresses = ref([]);

  // Consent: only save an address when the customer ticks the box
  const saveShipping = ref(false);
  const saveBilling = ref(false);

  const couponInput = ref('');
  const couponError = ref('');
  const loading = ref(false);
  const error = ref('');

  const shippingMethods = ref([]);
  const selectedShippingMethodId = ref(null);
  const shippingChecked = ref(false); // true once Vendure has told us which methods are eligible

  // ── Helpers ──
  function resetForm() {
    shippingAddress.value = createEmptyAddress();
    billingAddress.value = createEmptyAddress();
    billingSameAsShipping.value = true;
    savedAddresses.value = [];
    saveShipping.value = false;
    saveBilling.value = false;
    couponInput.value = '';
    couponError.value = '';
    shippingMethods.value = [];
    selectedShippingMethodId.value = null;
    shippingChecked.value = false;
  }

  // Runs an order mutation and stores the updated order in the cart store.
  // Returns true on success, false if Vendure answered with an error.
  async function runOrderMutation(mutation, variables, resultKey) {
    const data = await getClient().request(mutation, variables);
    const result = data[resultKey];

    if (result?.errorCode) {
      error.value = result.message;
      return false;
    }

    cart.order = result;
    return true;
  }

  // ── Saved address cards ──
  // The id of the saved address that matches this form, or null when it is a new address
  function matchingSavedId(address) {
    const key = addressKey(address);
    return savedAddresses.value.find((saved) => addressKey(saved) === key)?.id || null;
  }

  // Fills the shipping or billing form from a saved card
  function selectSavedAddress(target, saved) {
    const { id, ...fields } = saved;
    if (target === 'shipping') {
      shippingAddress.value = { ...fields };
      saveShipping.value = false;
    } else {
      billingAddress.value = { ...fields };
      saveBilling.value = false;
    }
  }

  // Clears the shipping or billing form for a brand new address
  function startNewAddress(target) {
    if (target === 'shipping') {
      shippingAddress.value = createEmptyAddress();
    } else {
      billingAddress.value = createEmptyAddress();
    }
  }

  // ── Loading the page ──
  async function prefillForm() {
    const data = await getClient().request(GET_CHECKOUT_CUSTOMER);
    const customer = data.activeCustomer;
    if (!customer) return;

    savedAddresses.value = customer.addresses.map((saved) => ({
      id: saved.id,
      ...addressFromSaved(saved),
    }));

    // Returning from payment: the order already has the addresses
    const orderShipping = cart.order?.shippingAddress;
    const orderBilling = cart.order?.billingAddress;

    if (orderShipping?.streetLine1) {
      shippingAddress.value = addressFromOrder(orderShipping);
    } else {
      // First visit: start from the customer's name and phone only
      shippingAddress.value.fullName = `${customer.firstName} ${customer.lastName}`.trim();
      shippingAddress.value.phoneNumber = customer.phoneNumber || '';
    }

    if (orderBilling?.streetLine1) {
      const billing = addressFromOrder(orderBilling);
      if (addressKey(billing) !== addressKey(shippingAddress.value)) {
        billingAddress.value = billing;
        billingSameAsShipping.value = false;
      }
    }
  }

  async function load() {
    loading.value = true;
    error.value = '';
    resetForm();

    try {
      await cart.flushAll();
      await cart.fetchActiveOrder();

      // Coming back from the payment page: unlock the order again
      if (cart.order?.state === 'ArrangingPayment') {
        await runOrderMutation(TRANSITION_ORDER_TO_STATE, { state: 'AddingItems' }, 'transitionOrderToState');
      }

      // Returning from payment: remember the method already on the order
      selectedShippingMethodId.value = cart.order?.shippingLines?.[0]?.shippingMethod?.id || null;

      await prefillForm();
    } catch (err) {
      error.value = readError(err);
    } finally {
      loading.value = false;
    }
  }

  // ── Shipping ──
  function setShippingMethod(id) {
    return runOrderMutation(
      SET_ORDER_SHIPPING_METHOD,
      { shippingMethodId: [id] },
      'setOrderShippingMethod'
    );
  }

  // Called when the customer picks one from the list
  async function chooseShippingMethod(id) {
    error.value = '';
    selectedShippingMethodId.value = id;

    try {
      await setShippingMethod(id);
    } catch (err) {
      error.value = readError(err);
    }
  }

  // Returns true when shipping is settled and checkout can continue
  async function resolveShipping() {
    const data = await getClient().request(GET_ELIGIBLE_SHIPPING_METHODS);
    shippingMethods.value = data.eligibleShippingMethods;
    shippingChecked.value = true;

    const methods = shippingMethods.value;

    // No methods: shipping is free, nothing to set
    if (methods.length === 0) {
      selectedShippingMethodId.value = null;
      return true;
    }

    // One method: use it
    if (methods.length === 1) {
      selectedShippingMethodId.value = methods[0].id;
      return setShippingMethod(methods[0].id);
    }

    // Several methods: the customer must choose
    const choiceIsValid = methods.some((m) => m.id === selectedShippingMethodId.value);
    if (!choiceIsValid) {
      selectedShippingMethodId.value = null;
      error.value = 'Please choose a shipping method.';
      return false;
    }

    return setShippingMethod(selectedShippingMethodId.value);
  }

  // ── Saving addresses (only with consent) ──
  // Saving is a convenience: if it fails, checkout still continues
  async function saveAddresses() {
    try {
      const toSave = [];
      if (saveShipping.value) toSave.push(shippingAddress.value);
      if (!billingSameAsShipping.value && saveBilling.value) toSave.push(billingAddress.value);

      const knownKeys = new Set(savedAddresses.value.map(addressKey));

      for (const address of toSave) {
        const key = addressKey(address);
        if (knownKeys.has(key)) continue; // already saved, don't duplicate

        const input = toAddressInput(address);
        const data = await getClient().request(CREATE_CUSTOMER_ADDRESS, { input });

        savedAddresses.value.push({ id: data.createCustomerAddress.id, ...input });
        knownKeys.add(key);
      }

      saveShipping.value = false;
      saveBilling.value = false;
    } catch (err) {
      console.warn('Could not save the address', err);
    }
  }

  // ── Submitting step 1 ──
  // Returns true when the order is ready for the payment page
  async function submitCustomerInfo() {
    error.value = '';

    const shippingProblem = validateAddress(shippingAddress.value);
    if (shippingProblem) {
      error.value = shippingProblem;
      return false;
    }

    if (!billingSameAsShipping.value) {
      const billingProblem = validateAddress(billingAddress.value);
      if (billingProblem) {
        error.value = `Billing address: ${billingProblem}`;
        return false;
      }
    }

    loading.value = true;

    try {
      const billing = billingSameAsShipping.value ? shippingAddress.value : billingAddress.value;

      const shippingAddressSet = await runOrderMutation(
        SET_ORDER_SHIPPING_ADDRESS,
        { input: toAddressInput(shippingAddress.value) },
        'setOrderShippingAddress'
      );
      if (!shippingAddressSet) return false;

      const billingAddressSet = await runOrderMutation(
        SET_ORDER_BILLING_ADDRESS,
        { input: toAddressInput(billing) },
        'setOrderBillingAddress'
      );
      if (!billingAddressSet) return false;

      const shippingMethodSet = await resolveShipping();
      if (!shippingMethodSet) return false;

      await saveAddresses();
      return true;
    } catch (err) {
      error.value = readError(err);
      return false;
    } finally {
      loading.value = false;
    }
  }

  // ── Coupons ──
  async function applyCoupon() {
    const code = couponInput.value.trim();
    if (!code) return;

    couponError.value = '';

    try {
      const data = await getClient().request(APPLY_COUPON_CODE, { couponCode: code });
      const result = data.applyCouponCode;

      if (result.errorCode) {
        couponError.value = result.message;
        return;
      }

      cart.order = result;
      couponInput.value = '';
    } catch (err) {
      couponError.value = readError(err);
    }
  }

  async function removeCoupon(code) {
    couponError.value = '';

    try {
      const data = await getClient().request(REMOVE_COUPON_CODE, { couponCode: code });
      if (data.removeCouponCode) {
        cart.order = data.removeCouponCode;
      }
    } catch (err) {
      couponError.value = readError(err);
    }
  }

  return {
    shippingAddress,
    billingAddress,
    billingSameAsShipping,
    savedAddresses,
    saveShipping,
    saveBilling,
    couponInput,
    couponError,
    loading,
    error,
    shippingMethods,
    selectedShippingMethodId,
    shippingChecked,
    load,
    matchingSavedId,
    selectSavedAddress,
    startNewAddress,
    submitCustomerInfo,
    chooseShippingMethod,
    applyCoupon,
    removeCoupon,
  };
});
</file>

<file path="app/store/cms.js">
import { defineStore } from 'pinia';
import { ref } from 'vue';

/**
 * Single Point of Truth Store (CMS)
 * 
 * This store dictates the structure and content of our application,
 * populated by the Strapi CMS.
 */
export const useCmsStore = defineStore('cms', () => {
  // ── State ──
  
  // Global Layout settings (e.g. Header configs, Footer configs, Site config)
  const globalLayout = ref({
    header: null,
    footer: null
  });

  // Current page schema/metadata (Title, SEO data, Slug)
  const pageMeta = ref({});
  
  // Current page dynamic layout blocks (Array of component objects from Strapi)
  const pageBlocks = ref([]);
  
  const loading = ref(false);
  const error = ref(null);

  // ── Actions ──

  /**
   * Fetches the global configuration (Header, Footer, Nav Links) from Strapi 
   * via our Nuxt Nitro caching layer.
   */
  async function fetchGlobalLayout() {
    try {
      const response = await $fetch('/api/cms/global');
      globalLayout.value = response || {};
      return response;
    } catch (err) {
      console.error('Failed to fetch global layout geometry:', err);
    }
  }

  /**
   * Fetches a specific page by its slug. The API will respond with 
   * the component arrangement (LayoutBlocks) telling the frontend exactly what to render.
   * 
   * @param {String} slug 
   */
  async function fetchPage(slug) {
      loading.value = true;
      error.value = null;
      pageBlocks.value = [];
      pageMeta.value = {};
    try {
      const response = await $fetch(`/api/cms/page?slug=${slug}`);
      pageMeta.value = response?.meta || {};
      pageBlocks.value = response?.blocks || [];
      return response;
    } catch (err) {
      error.value = err.message || 'Failed to fetch page schema.';
      throw err;
    } finally {
      loading.value = false;
    }
  }

  /**
   * Clear out the page setup (useful on unmounts or page transitions)
   */
  function clearPage() {
    pageBlocks.value = [];
    pageMeta.value = {};
    error.value = null;
  }

  return {
    // State
    globalLayout,
    pageMeta,
    pageBlocks,
    loading,
    error,
    
    // Actions
    fetchGlobalLayout,
    fetchPage,
    clearPage
  };
});
</file>

